-- Font loading. Display text uses Builder Extended (assets/fonts); body text
-- uses Inter when its files are in assets/fonts, else Segoe UI. CJK, Hangul
-- and emoji come from the system's own fonts through the fallback list.

local ui = require("@neyuki/ui")
local fs = require("@neyuki/fs")

local fonts = {}

local function file(name: string): any
    local path = "assets/fonts/" .. name
    if fs.exists(path) then return ui.loadFont(path) end
    return nil
end

-- A body face of `weight`: Inter if bundled, else the installed Segoe UI.
local function body(weight: number, interFile: string): any
    return file(interFile)
        ?? ui.systemFont("Segoe UI", { weight = weight })
        ?? ui.systemFont("Arial", { weight = weight })
end

function fonts.load()
    fonts.display = file("BuilderExtended-Bold.otf")
    fonts.displayHeavy = file("BuilderExtended-ExtraBold.otf") ?? fonts.display
    fonts.displayLight = file("BuilderExtended-SemiBold.otf") ?? fonts.display
    fonts.regular = body(400, "Inter-Regular.ttf")
    fonts.medium = body(500, "Inter-Medium.ttf") ?? fonts.regular
    fonts.semibold = body(600, "Inter-SemiBold.ttf") ?? fonts.medium
    fonts.bold = body(700, "Inter-Bold.ttf") ?? fonts.semibold

    local fallbacks = {}
    for _, family in { "Yu Gothic UI", "Malgun Gothic", "Microsoft YaHei UI", "Segoe UI Symbol", "Segoe UI Emoji" } do
        local font = ui.systemFont(family)
        if font then table.insert(fallbacks, font) end
    end
    ui.setFallbackFonts(fallbacks)
end

return fonts
