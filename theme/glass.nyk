-- Frosted-glass panels: blur what is already drawn under a rectangle, tint it
-- and give it a hairline border, like a CSS backdrop-filter.

local tokens = require("theme/tokens")

local glass = {}

-- options: radius, tint (default the dark panel color), blur (default 24),
-- border (false for none)
function glass.panel(target: any, x: number, y: number, w: number, h: number, options: table?)
    local o = options ?? {}
    local radius = o.radius ?? tokens.radius.panel
    local blur = o.blur ?? 24
    if blur > 0 then target:blurRegion(x, y, w, h, blur, { radius = radius }) end
    target:fillRect(x, y, w, h, o.tint ?? tokens.color.panel, { radius = radius })
    if o.border ~= false then
        target:strokeRect(x + 0.5, y + 0.5, w - 1, h - 1, o.border ?? tokens.color.panelBorder, { radius = radius, width = 1 })
    end
end

return glass
